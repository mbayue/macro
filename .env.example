# Macro settings. Copy to .env and fill in the secrets. Never commit .env.
# Placeholder values only in this file.

# --- LLM Serverless Inference (required) ---
# Compatible with OpenAI-compatible endpoints (Vultr, OpenAI, DeepSeek, Groq, Ollama, etc.)
# VULTR_INFERENCE_API_KEY and AI_API_KEY are accepted as backwards-compatible aliases.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_MODEL=minimax-m3.1-flash
INFERENCE_FALLBACK_MODEL=mimo-v2.6-flash

# --- Firebase AI Logic (required for client-side Hybrid Inference) ---
# Powers on-device Gemini Nano with cloud fallback (Scenario Assistant & Report Q&A).
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
# Optional Firebase settings:
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_APPCHECK_SITE_KEY=

# --- Cloudflare Turnstile (required) ---
# Local development can use Cloudflare's always-pass test keys.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Target (first entry = web role, second = api role) ---
TARGET_ORIGINS=https://yue.macro.my.id,https://api.yue.macro.my.id

# --- Sandbox ---
# runsc (gVisor, default) or runc (explicit opt-out).
SANDBOX_RUNTIME=runsc
# Must contain @sha256:. Pinned k6 v2.3.0 (linux/amd64).
K6_IMAGE=grafana/k6@sha256:3e4186aea62e11a45560bfc51e19eeafe82fc07ce069c78aff44b7ff893d9a5e
# This host's public IPv4 (egress proxy blocklist). Must match the macro VM origin in production.
MACRO_VM_IP=139.180.219.252

# --- Server ---
PORT=3000
# Same path on host and in container (Docker bind mounts use host paths).
DATA_DIR=/var/lib/macro
# Docker endpoint. Leave unset for the local unix socket; the compose deploy
# sets DOCKER_HOST=tcp://socket-proxy:2375 for you (least-privilege socket proxy).
# On a Windows dev box, pipe:// reaches Docker Desktop's named pipe so bun run dev works:
# DOCKER_HOST=pipe://\\.\pipe\docker_engine

# --- Optional: Firewall management. Leave empty otherwise. ---
VULTR_API_KEY=

# --- Optional: Tiger Cloud mirror (public-run per-second samples). Leave empty to disable. ---
# postgres:// connection string; SQLite stays the source of truth, the mirror is best effort.
# TIGERDATA_URL=

# --- Optional accounts / own-site verification (all-or-nothing core) ---
# Leave SESSION_SECRET / RESEND_* unset to keep sign-in disabled (demo-only mode).
# Set them to enable accounts, magic-link auth, and origin verification.
# SESSION_SECRET=
# PUBLIC_BASE_URL=https://macro.my.id
# RESEND_API_KEY=
# RESEND_FROM=Macro <hello@macro.my.id>

# --- Optional GitHub OAuth (requires core auth block above) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://macro.my.id/api/auth/github/callback

# --- Optional Direct Google OAuth (requires core auth block above) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://macro.my.id/api/auth/google/callback

# --- Optional Domain Connect signing (requires RSA private key; keyId defaults to p1) ---
# DOMAIN_CONNECT_PRIVATE_KEY=
# DOMAIN_CONNECT_KEY_ID=p1
