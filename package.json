{
  "name": "macro",
  "version": "0.1.0",
  "description": "Macro: describe a traffic event, get a safe, measured load test and the point where your site breaks.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:vm": "MACRO_VM_TEST=1 bun test test/vm/",
    "build:web": "bun run scripts/build-web.ts",
    "dev:landing": "vite --config web/landing/vite.config.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.3.0",
    "fast-check": "^4.10.2",
    "react": "19",
    "react-dom": "19",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
