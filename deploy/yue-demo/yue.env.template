# Demo_Target environment for YUE on the `yue-demo` VM -> /opt/yue/.env
# Placeholders only. Safe to commit. Never put real values in this file.
#
# Create the real file on the VM (mode 600, owner root), generating fresh secrets:
#   PG=$(openssl rand -hex 32); JWT=$(openssl rand -hex 32)
#   sed -e "s/__POSTGRES_PASSWORD__/$PG/g" -e "s/__JWT_SECRET__/$JWT/g" yue.env.template > /opt/yue/.env
#   chmod 600 /opt/yue/.env
#
# docker compose reads /opt/yue/.env for ${VAR} interpolation. The base
# docker-compose.yml hardcodes several API settings, so the override file
# (deploy/yue-demo/docker-compose.override.yml) MUST pass these through:
#   db:   POSTGRES_USER=${POSTGRES_USER}  POSTGRES_PASSWORD=${POSTGRES_PASSWORD}  POSTGRES_DB=${POSTGRES_DB}
#         (the base healthcheck hardcodes `-U yue -d yue_db`, so keep those two values)
#   api:  DATABASE_URL, REDIS_URL, JWT_SECRET, JWT_EXPIRES_IN, WEB_URL, SWAGGER_ENABLED,
#         RATE_LIMIT_ALLOWLIST, TRUST_PROXY, KAFKA_BROKERS   (base file hardcodes
#         DATABASE_URL=postgresql://yue:yue@db..., SWAGGER_ENABLED="true", and sets no WEB_URL)
#   web:  build arg NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
#   db, redis, api, web: reset the base `ports:` so nothing but Caddy (80/443) is published.

NODE_ENV=production
PORT=3001

# --- Local Postgres (compose `db` service) ---
POSTGRES_USER=yue
POSTGRES_DB=yue_db
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__
DATABASE_URL=postgresql://yue:__POSTGRES_PASSWORD__@db:5432/yue_db

# --- Local Redis (compose `redis` service) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=__JWT_SECRET__
JWT_EXPIRES_IN=1d

# --- Origins ---
WEB_URL=https://yue.macro.my.id
# Inlined into the web bundle at BUILD time.
NEXT_PUBLIC_API_URL=https://api.yue.macro.my.id

SWAGGER_ENABLED=false

# --- Rate-limit exemption (applied by rate-limit-allowlist.patch) ---
# Comma-separated source IPs exempt from both rate limiters. Here: the `macro` VM.
RATE_LIMIT_ALLOWLIST=45.77.37.116
# Fastify trusts X-Forwarded-For only from these peers (Caddy over a Docker bridge network).
# Comma-separated IPs/CIDRs, or `true`. Unset/empty = trust no proxy.
TRUST_PROXY=172.16.0.0/12

# --- Outbound notifications: empty, so the Demo_Target sends none ---
DISCORD_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

# --- Kafka: no broker exists. ---
# env.schema.ts rejects an empty KAFKA_BROKERS (min length 1) and defaults an unset one to
# localhost:9092. `.invalid` never resolves (RFC 2606), so the API cannot reach any broker and
# runs without Kafka after a short failed connect at boot. All other KAFKA_* settings are
# left absent (defaults only; no SSL, no SASL).
KAFKA_BROKERS=kafka.invalid:9092

# --- S3 / AWS: all AWS_* settings left absent (payment proofs fall back to inline storage).
# Partial sets are a boot error, so leave all of them out; do not set any one of them.
