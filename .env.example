# Macro settings. Copy to .env and fill in the secrets. Never commit .env.
# Placeholder values only in this file.

# --- Vultr Serverless Inference (required) ---
# AI_API_KEY is accepted as an alias for VULTR_INFERENCE_API_KEY.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=minimax-m3.1-flash
VULTR_INFERENCE_FALLBACK_MODEL=mimo-v2.6-flash

# --- Cloudflare Turnstile (required) ---
# Local development can use Cloudflare's always-pass test keys.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- Target (first entry = web role, second = api role) ---
TARGET_ORIGINS=https://yue.macro.my.id,https://api.yue.macro.my.id

# --- Sandbox ---
# runsc (gVisor, default) or runc (explicit opt-out).
SANDBOX_RUNTIME=runsc
# Must contain @sha256:. Pinned k6 v2.3.0 (linux/amd64).
K6_IMAGE=grafana/k6@sha256:3e4186aea62e11a45560bfc51e19eeafe82fc07ce069c78aff44b7ff893d9a5e
# Added to the egress proxy's blocked-IP list.
MACRO_VM_IP=45.77.37.116

# --- Server ---
PORT=3000
# Same path on host and in container (Docker bind mounts use host paths).
DATA_DIR=/var/lib/macro
# Docker endpoint. Leave unset for the local unix socket; the compose deploy
# sets DOCKER_HOST=tcp://socket-proxy:2375 for you (least-privilege socket proxy).
# On a Windows dev box, pipe:// reaches Docker Desktop's named pipe so bun run dev works:
# DOCKER_HOST=pipe://\\.\pipe\docker_engine

# --- Optional: Requirement 17 only (regional runs). Leave empty otherwise. ---
VULTR_API_KEY=

# --- Optional: Tiger Cloud mirror (public-run per-second samples). Leave empty to disable. ---
# postgres:// connection string; SQLite stays the source of truth, the mirror is best effort.
# TIGERDATA_URL=

# --- Optional accounts / own-site verification (all-or-nothing) ---
# Leave every AUTH line unset to keep sign-in disabled.
# Set all of them to enable GitHub + Resend magic-link auth and origin verification.
# SESSION_SECRET=
# PUBLIC_BASE_URL=https://macro.my.id
# RESEND_API_KEY=
# RESEND_FROM=Macro <hello@macro.my.id>
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=https://macro.my.id/api/auth/github/callback
