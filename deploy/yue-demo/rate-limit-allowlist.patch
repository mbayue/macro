diff --git a/apps/api/src/common/guards/allowlist-throttler.guard.ts b/apps/api/src/common/guards/allowlist-throttler.guard.ts
new file mode 100644
index 0000000..5810076
--- /dev/null
+++ b/apps/api/src/common/guards/allowlist-throttler.guard.ts
@@ -0,0 +1,31 @@
+import type { ExecutionContext } from '@nestjs/common'
+import { Injectable } from '@nestjs/common'
+import { ThrottlerGuard } from '@nestjs/throttler'
+
+/** Parses RATE_LIMIT_ALLOWLIST (comma-separated IPs). Empty or unset exempts nobody. */
+export function parseRateLimitAllowlist(raw: string | undefined): string[] {
+  return (raw ?? '')
+    .split(',')
+    .map((ip) => ip.trim())
+    .filter(Boolean)
+}
+
+/** True when `ip` (IPv4-mapped IPv6 form accepted) is in the allowlist. */
+export function isAllowlistedIp(ip: string | undefined, allowList: readonly string[]): boolean {
+  if (!ip || allowList.length === 0) return false
+  return allowList.includes(ip.replace(/^::ffff:/i, ''))
+}
+
+/**
+ * ThrottlerGuard that skips every throttler, including per-route @Throttle
+ * limits, for source IPs listed in RATE_LIMIT_ALLOWLIST.
+ */
+@Injectable()
+export class AllowlistThrottlerGuard extends ThrottlerGuard {
+  private readonly allowList = parseRateLimitAllowlist(process.env.RATE_LIMIT_ALLOWLIST)
+
+  protected async shouldSkip(context: ExecutionContext): Promise<boolean> {
+    const { req } = this.getRequestResponse(context)
+    return isAllowlistedIp(req.ip, this.allowList)
+  }
+}
