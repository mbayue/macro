rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: scenario_templates
// Document ID: slug (e.g., "campaign-spike", "live-mention")
// Fields:
//   - label: string (required, 1..60 chars) - Short chip label in Test Studio
//   - text: string (required, 10..1000 chars) - Plain-English Traffic Description
//   - order: number (required, 0..1000) - Ascending display order
//   - active: bool (required) - Whether shown in Test Studio
//
// Access pattern:
//   - Public read-only curated templates (zero PII), explicitly approved for
//     signed-out Test Studio usage and protected by Firebase App Check.
//   - All client writes are denied; templates are managed via admin tooling.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Domain validator for scenario_templates documents.
    function isValidScenarioTemplate(data) {
      return hasOnlyAllowedFields(['label', 'text', 'order', 'active']) &&
        hasRequiredFields(['label', 'text', 'order', 'active']) &&
        validStringLength('label', 1, 60) &&
        validStringLength('text', 10, 1000) &&
        data.order is number && data.order >= 0 && data.order <= 1000 &&
        data.active is bool;
    }

    // Curated public read-only scenario templates for Test Studio (zero PII).
    match /scenario_templates/{templateId} {
      allow read: if true;
      allow create, update: if false && isValidScenarioTemplate(request.resource.data);
      allow delete: if false;
    }

    // Default deny for all other collections and documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
